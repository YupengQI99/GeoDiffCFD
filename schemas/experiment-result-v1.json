{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/YupengQI99/jax_cad/schemas/experiment-result-v1.json",
  "title": "jax_cad experiment result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "experiment_id", "run_id", "git", "command", "timestamps", "configuration", "hardware", "software", "primal", "objective", "gradient", "timing", "memory", "artifacts"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "experiment_id": {"type": "string", "minLength": 3, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "run_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "branch", "dirty"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
        "branch": {"type": ["string", "null"]},
        "dirty": {"type": "boolean"}
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv", "working_directory"],
      "properties": {
        "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "working_directory": {"type": "string", "minLength": 1}
      }
    },
    "timestamps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_utc", "end_utc", "status", "exit_code"],
      "properties": {
        "start_utc": {"type": "string", "format": "date-time"},
        "end_utc": {"type": "string", "format": "date-time"},
        "status": {"enum": ["success", "failed", "partial"]},
        "exit_code": {"type": ["integer", "null"]}
      }
    },
    "configuration": {"type": "object", "additionalProperties": true},
    "hardware": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostname", "platform", "cpu_model", "logical_cpu_count", "memory_bytes", "accelerators"],
      "properties": {
        "hostname": {"type": "string", "minLength": 1},
        "platform": {"type": "string", "minLength": 1},
        "cpu_model": {"type": ["string", "null"]},
        "logical_cpu_count": {"type": "integer", "minimum": 1},
        "process_cpu_affinity": {
          "type": ["array", "null"],
          "items": {"type": "integer", "minimum": 0},
          "uniqueItems": true
        },
        "memory_bytes": {"type": ["integer", "null"], "minimum": 0},
        "device_visibility": {
          "type": "object",
          "additionalProperties": {"type": ["string", "null"]}
        },
        "accelerators": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["platform", "name", "count", "memory_bytes", "driver"],
            "properties": {
              "platform": {"type": "string", "minLength": 1},
              "name": {"type": "string", "minLength": 1},
              "count": {"type": "integer", "minimum": 1},
              "memory_bytes": {"type": ["integer", "null"], "minimum": 0},
              "driver": {"type": ["string", "null"]}
            }
          }
        }
      }
    },
    "software": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python", "jax", "jaxlib", "numpy", "scipy", "backend", "precision", "environment_variables"],
      "properties": {
        "python": {"type": "string"},
        "jax": {"type": ["string", "null"]},
        "jaxlib": {"type": ["string", "null"]},
        "numpy": {"type": ["string", "null"]},
        "scipy": {"type": ["string", "null"]},
        "jax_cuda_plugin": {"type": ["string", "null"]},
        "jax_cuda_pjrt": {"type": ["string", "null"]},
        "backend": {"type": ["string", "null"]},
        "backend_platform_version": {"type": ["string", "null"]},
        "cuda_toolkit_nvcc": {"type": ["string", "null"]},
        "precision": {"enum": ["float32", "float64", "mixed", "other"]},
        "environment_variables": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "primal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["converged", "iterations", "residual_norm", "divergence_rms", "divergence_max", "mass_flux_mismatch", "failure_reason"],
      "properties": {
        "converged": {"type": "boolean"},
        "iterations": {"type": "integer", "minimum": 0},
        "residual_norm": {"$ref": "#/$defs/nullableNonnegative"},
        "divergence_rms": {"$ref": "#/$defs/nullableNonnegative"},
        "divergence_max": {"$ref": "#/$defs/nullableNonnegative"},
        "mass_flux_mismatch": {"$ref": "#/$defs/nullableNonnegative"},
        "failure_reason": {"type": ["string", "null"]}
      }
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value", "units", "normalization"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "value": {"type": ["number", "null"]},
        "units": {"type": ["string", "null"]},
        "normalization": {"type": ["string", "null"]}
      }
    },
    "gradient": {
      "type": "object",
      "additionalProperties": false,
      "required": ["success", "backend", "parameterization", "parameter_names", "values", "norm", "adjoint_residual", "message", "taylor_test"],
      "properties": {
        "success": {"type": "boolean"},
        "backend": {"enum": ["unrolled", "checkpointed-unrolled", "implicit", "forward-mode", "finite-difference", "none"]},
        "parameterization": {"type": ["string", "null"]},
        "parameter_names": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "values": {"type": "array", "items": {"type": "number"}},
        "norm": {"$ref": "#/$defs/nullableNonnegative"},
        "adjoint_residual": {"$ref": "#/$defs/nullableNonnegative"},
        "message": {"type": ["string", "null"]},
        "taylor_test": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["epsilons", "first_order_remainders", "first_order_rates"],
          "properties": {
            "epsilons": {"type": "array", "minItems": 2, "items": {"type": "number", "exclusiveMinimum": 0}},
            "first_order_remainders": {"type": "array", "minItems": 2, "items": {"type": "number", "minimum": 0}},
            "first_order_rates": {"type": "array", "minItems": 1, "items": {"type": "number"}}
          }
        }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compile_seconds", "forward_samples_seconds", "gradient_samples_seconds", "optimizer_step_samples_seconds"],
      "properties": {
        "compile_seconds": {"$ref": "#/$defs/nullableNonnegative"},
        "forward_samples_seconds": {"type": "array", "items": {"type": "number", "minimum": 0}},
        "gradient_samples_seconds": {"type": "array", "items": {"type": "number", "minimum": 0}},
        "optimizer_step_samples_seconds": {"type": "array", "items": {"type": "number", "minimum": 0}}
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["peak_host_bytes", "peak_accelerator_bytes", "measurement_method"],
      "properties": {
        "peak_host_bytes": {"type": ["integer", "null"], "minimum": 0},
        "peak_accelerator_bytes": {"type": ["integer", "null"], "minimum": 0},
        "measurement_method": {"type": "string", "minLength": 1}
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "media_type", "role"],
        "properties": {
          "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$)).+$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
          "media_type": {"type": "string", "minLength": 1},
          "role": {"enum": ["config", "environment", "log", "residual-history", "field", "geometry", "figure", "table", "other"]}
        }
      }
    },
    "notes": {"type": ["string", "null"]}
  },
  "$defs": {
    "nullableNonnegative": {"oneOf": [{"type": "number", "minimum": 0}, {"type": "null"}]}
  }
}
